\newlabel{fig:rawdata}{{4}{5}{(a) Observed non-spin-flip ($I^{++}_\mathrm {obs}$), and (b) spin-flip ($I^{+-}_\mathrm {obs}$), showing only the analyzing region. (c) Line profile along the $x$ direction, obtained by integrating the intensity within the dashed regions in (a) and (b)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Time dependence of the $^3$He polarization, neutron polarization, and neutron transmission. The open circles show the $^3$He polarization determined from the intensity of the $\bar  {1}02$ nuclear reflection, while the closed circles show the $^3$He NMR signal. The red line represents the fitting result for the NMR signal using an exponential decay function. The dashed and broken lines indicate the calculated neutron polarization and transmission, respectively, obtained from the $^3$He polarization. }}{6}{figure.5}\protected@file@percent }
\newlabel{fig:pol_trans_decay}{{5}{6}{Time dependence of the \He polarization, neutron polarization, and neutron transmission. The open circles show the \He polarization determined from the intensity of the $\bar {1}02$ nuclear reflection, while the closed circles show the \He NMR signal. The red line represents the fitting result for the NMR signal using an exponential decay function. The dashed and broken lines indicate the calculated neutron polarization and transmission, respectively, obtained from the \He polarization}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  (a) Raw data, obtained by integrating the intensity over the peak region on the 2D detector while scanning the sample rotation angle $\omega $. The red and blue symbols represent the non-spin-flip intensity $\mathcal  {I}^{++}_\mathrm  {obs}$ and spin-flip intensity $\mathcal  {I}^{+-}_\mathrm  {obs}$, respectively. (b) Corrected data along the $(H,0,2)$ line, obtained after converting the raw data into reciprocal-space coordinates. The red and blue symbols represent the corrected non-spin-flip and spin-flip scattering intensities, $I^{++}(H,K,L)$ and $I^{+-}(H,K,L)$, respectively. }}{6}{figure.6}\protected@file@percent }
\newlabel{fig:polcorrection}{{6}{6}{(a) Raw data, obtained by integrating the intensity over the peak region on the 2D detector while scanning the sample rotation angle $\omega $. The red and blue symbols represent the non-spin-flip intensity $\mathcal {I}^{++}_\mathrm {obs}$ and spin-flip intensity $\mathcal {I}^{+-}_\mathrm {obs}$, respectively. (b) Corrected data along the $(H,0,2)$ line, obtained after converting the raw data into reciprocal-space coordinates. The red and blue symbols represent the corrected non-spin-flip and spin-flip scattering intensities, $I^{++}(H,K,L)$ and $I^{+-}(H,K,L)$, respectively}{figure.6}{}}

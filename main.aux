\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Measured and calculated asymmetries for the $(-1,0,2)-\bm  {q}_1$ and $(-1,0,2)-\bm  {q}_3$ reflections. The asymmetry is defined as $(I^{++}-I^{+-})/(I^{++}+I^{+-})$. The experimental values were obtained by integrating the line profiles shown in Figs.~7(f) and 7(g). The $c$-axis-parallel and oblique sinusoidal models of the magnetic moment $\mathbf  {M}$ are illustrated in Figs.~8(a) and 8(b), respectively. }}{8}{table.2}\protected@file@percent }
\newlabel{tab:asymmetry}{{II}{8}{Measured and calculated asymmetries for the $(-1,0,2)-\boldsymbol {q}_1$ and $(-1,0,2)-\boldsymbol {q}_3$ reflections. The asymmetry is defined as $(I^{++}-I^{+-})/(I^{++}+I^{+-})$. The experimental values were obtained by integrating the line profiles shown in Figs.~7(f) and 7(g). The $c$-axis-parallel and oblique sinusoidal models of the magnetic moment $\mathbf {M}$ are illustrated in Figs.~8(a) and 8(b), respectively}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Schematic illustrations of the sinusoidal magnetic structures. (a) the $c$-axis-parallel sinusoidal model and (b) the oblique sinusoidal model. The $\bm  {q}_1^\mathrm  {ab}$ vector is the projection of the magnetic propagation vector $\bm  {q}_1$ onto the $ab$ plane. The $P_n$ vector is the neutron polarization direction, which is parallel to the $z$ axis in Fig.~\ref {fig:measured_Qregion}(a). Inset of the panel (b) shows the definition of the polar angle $\theta $ and azimuthal angle $\phi $. In the oblique sinusoidal model, the magnetic moment direction $\mathbf  {M}$ is specified by $\theta = 49.5^\circ $ and $\phi = 108.5^\circ $. }}{8}{figure.8}\protected@file@percent }
\newlabel{fig:qvector}{{8}{8}{Schematic illustrations of the sinusoidal magnetic structures. (a) the $c$-axis-parallel sinusoidal model and (b) the oblique sinusoidal model. The $\boldsymbol {q}_1^\mathrm {ab}$ vector is the projection of the magnetic propagation vector $\boldsymbol {q}_1$ onto the $ab$ plane. The $P_n$ vector is the neutron polarization direction, which is parallel to the $z$ axis in Fig.~\ref {fig:measured_Qregion}(a). Inset of the panel (b) shows the definition of the polar angle $\theta $ and azimuthal angle $\phi $. In the oblique sinusoidal model, the magnetic moment direction $\mathbf {M}$ is specified by $\theta = 49.5^\circ $ and $\phi = 108.5^\circ $}{figure.8}{}}

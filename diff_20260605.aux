\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  (a) Schematic illustration of the reciprocal-space region measured in the present experiment. The translucent volumes labeled (b), (c) and (d), (e) indicate the regions integrated along the \(L\) direction and the \((-K/2,K,0)\) direction, respectively. The dashed lines along the \(-H\) direction through \(\bm  {q}_3\) and \(\bm  {q}_1\) indicate the line cuts shown in panels (f) and (g), respectively. (b), (d) Unpolarized neutron intensity maps in the \((H,K/2,-1.5)\) and \((H,0,L)\) planes, respectively. (c), (e) Corresponding polarization-analysis maps obtained from the difference between the non-spin-flip and spin-flip intensities, \(I^{++}-I^{+-}\). (f), (g) Line profiles of the non-spin-flip and spin-flip intensities at \(\bm  {q}_3\) and \(\bm  {q}_1\), respectively. }}{7}{figure.7}\protected@file@percent }
\newlabel{fig:measured_Qregion}{{7}{7}{(a) Schematic illustration of the reciprocal-space region measured in the present experiment. The translucent volumes labeled (b), (c) and (d), (e) indicate the regions integrated along the \(L\) direction and the \((-K/2,K,0)\) direction, respectively. The dashed lines along the \(-H\) direction through \(\boldsymbol {q}_3\) and \(\boldsymbol {q}_1\) indicate the line cuts shown in panels (f) and (g), respectively. (b), (d) Unpolarized neutron intensity maps in the \((H,K/2,-1.5)\) and \((H,0,L)\) planes, respectively. (c), (e) Corresponding polarization-analysis maps obtained from the difference between the non-spin-flip and spin-flip intensities, \(I^{++}-I^{+-}\). (f), (g) Line profiles of the non-spin-flip and spin-flip intensities at \(\boldsymbol {q}_3\) and \(\boldsymbol {q}_1\), respectively}{figure.7}{}}
\newlabel{eq:Ipp}{{A1}{7}{}{equation.A.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Schematic diagram of the spin-dependent neutron intensity in the polarized neutron scattering experiment. The incident beam with intensity $N_0$ is polarized by the \ce {Cu2MnAl} polarizer and then scattered by the sample with the spin-dependent cross sections $\Sigma ^{++}$, $\Sigma ^{+-}$, $\Sigma ^{-+}$, and $\Sigma ^{--}$. The scattered neutrons are analyzed by the \DIFdelbeginFL  \textit  {{\color {red}\sout {ex-situ}}} \DIFdelendFL  $^3$He-NSF~ with transmission $T_a$ and polarization \DIFaddbeginFL  {\color {blue}\uwave {efficiency }}\DIFaddendFL  $p_a$\DIFdelbeginFL  {\color {red}\sout {before being detected}}\DIFdelendFL  . The \DIFdelbeginFL  {\color {red}\sout {detected }}\DIFdelendFL  \DIFaddbeginFL  {\color {blue}\uwave {measured }}\DIFaddendFL  intensity $I^{++}$ is given by the sum of the contributions from the four spin-scattering channels when \ce {Cu2MnAl} and $^3$He-NSF~ are both polarized in the same direction.}}{7}{figure.8}\protected@file@percent }
\newlabel{fig:appendix}{{8}{7}{Schematic diagram of the spin-dependent neutron intensity in the polarized neutron scattering experiment. The incident beam with intensity $N_0$ is polarized by the \ce {Cu2MnAl} polarizer and then scattered by the sample with the spin-dependent cross sections $\Sigma ^{++}$, $\Sigma ^{+-}$, $\Sigma ^{-+}$, and $\Sigma ^{--}$. The scattered neutrons are analyzed by the \DIFdelbeginFL \textit {\DIFdelFL {ex-situ}} \DIFdelendFL \Hensf ~ with transmission $T_a$ and polarization \DIFaddbeginFL \DIFaddFL {efficiency }\DIFaddendFL $p_a$\DIFdelbeginFL \DIFdelFL {before being detected}\DIFdelendFL . The \DIFdelbeginFL \DIFdelFL {detected }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {measured }\DIFaddendFL intensity $I^{++}$ is given by the sum of the contributions from the four spin-scattering channels when \ce {Cu2MnAl} and \Hensf ~ are both polarized in the same direction}{figure.8}{}}
